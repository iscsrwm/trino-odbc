/* Dialog resource for the Trino ODBC DSN setup GUI.
 * Displayed by the ODBC Data Source Administrator via ConfigDSN. */

#include <windows.h>
#include "resource.h"

IDD_CONFIG_DSN DIALOGEX 0, 0, 320, 340
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Trino ODBC Driver Setup"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    /* --- Data source identity --- */
    LTEXT           "Data Source Name:", IDC_STATIC, 10, 12, 90, 9
    EDITTEXT        IDC_DSN_NAME, 110, 10, 200, 13, ES_AUTOHSCROLL

    LTEXT           "Description:", IDC_STATIC, 10, 30, 90, 9
    EDITTEXT        IDC_DESCRIPTION, 110, 28, 200, 13, ES_AUTOHSCROLL

    /* --- Server --- */
    GROUPBOX        "Server", IDC_STATIC, 6, 46, 308, 64
    LTEXT           "Server (host):", IDC_STATIC, 14, 60, 90, 9
    EDITTEXT        IDC_SERVER, 110, 58, 150, 13, ES_AUTOHSCROLL
    LTEXT           "Port:", IDC_STATIC, 266, 60, 18, 9
    EDITTEXT        IDC_PORT, 286, 58, 24, 13, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "Catalog:", IDC_STATIC, 14, 78, 90, 9
    EDITTEXT        IDC_CATALOG, 110, 76, 90, 13, ES_AUTOHSCROLL
    LTEXT           "Schema:", IDC_STATIC, 210, 78, 30, 9
    EDITTEXT        IDC_SCHEMA, 244, 76, 66, 13, ES_AUTOHSCROLL

    /* --- Authentication --- */
    GROUPBOX        "Authentication", IDC_STATIC, 6, 114, 308, 64
    LTEXT           "Auth type:", IDC_STATIC, 14, 128, 90, 9
    COMBOBOX        IDC_AUTH, 110, 126, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "User:", IDC_STATIC, 14, 146, 90, 9
    EDITTEXT        IDC_USER, 110, 144, 90, 13, ES_AUTOHSCROLL
    LTEXT           "Password:", IDC_STATIC, 210, 146, 34, 9
    EDITTEXT        IDC_PASSWORD, 246, 144, 64, 13, ES_AUTOHSCROLL | ES_PASSWORD

    /* --- TLS / SSL --- */
    GROUPBOX        "TLS / SSL", IDC_STATIC, 6, 182, 308, 64
    AUTOCHECKBOX    "Enable SSL/TLS", IDC_SSL, 14, 195, 90, 10
    AUTOCHECKBOX    "Verify certificate", IDC_SSL_VERIFY, 120, 195, 90, 10
    AUTOCHECKBOX    "Skip revocation check", IDC_SSL_NOREVOKE, 220, 195, 90, 10
    LTEXT           "Trust store cert:", IDC_STATIC, 14, 214, 90, 9
    EDITTEXT        IDC_TRUSTSTORE, 110, 212, 200, 13, ES_AUTOHSCROLL

    /* --- Advanced --- */
    GROUPBOX        "Advanced", IDC_STATIC, 6, 250, 308, 78
    LTEXT           "Source:", IDC_STATIC, 14, 263, 90, 9
    EDITTEXT        IDC_SOURCE, 110, 261, 90, 13, ES_AUTOHSCROLL
    LTEXT           "Client tags:", IDC_STATIC, 210, 263, 38, 9
    EDITTEXT        IDC_CLIENT_TAGS, 250, 261, 60, 13, ES_AUTOHSCROLL
    LTEXT           "Session props:", IDC_STATIC, 14, 281, 90, 9
    EDITTEXT        IDC_SESSION_PROPS, 110, 279, 200, 13, ES_AUTOHSCROLL
    LTEXT           "Query timeout (s):", IDC_STATIC, 14, 299, 90, 9
    EDITTEXT        IDC_QUERY_TIMEOUT, 110, 297, 40, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Connect timeout (s):", IDC_STATIC, 175, 299, 70, 9
    EDITTEXT        IDC_CONN_TIMEOUT, 250, 297, 40, 13, ES_AUTOHSCROLL | ES_NUMBER

    /* --- Buttons --- */
    PUSHBUTTON      "Test Connection", IDC_TEST, 6, 320, 70, 14
    DEFPUSHBUTTON   "OK", IDOK, 214, 320, 46, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 264, 320, 46, 14
END
