Windows Registry Editor Version 5.00

; Install Trino ODBC Driver - 64-bit
[HKEY_LOCAL_MACHINE\SOFTWARE\ODBC\ODBCINST.INI\ODBC Drivers]
"Trino ODBC Driver"="Installed"

[HKEY_LOCAL_MACHINE\SOFTWARE\ODBC\ODBCINST.INI\Trino ODBC Driver]
"Driver"="C:\Program Files\TrinoODBC\bin\trino_odbc.dll"
"APILevel"=dword:00000001
"ConnectFunctions"="YYN"
"DriverODBCVer"="03.51"
"SQLLevel"=dword:00000001

; Install Trino ODBC Driver - 32-bit (WoW64)
[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\ODBC\ODBCINST.INI\ODBC Drivers]
"Trino ODBC Driver"="Installed"

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\ODBC\ODBCINST.INI\Trino ODBC Driver]
"Driver"="C:\Program Files (x86)\TrinoODBC\bin\trino_odbc.dll"
"APILevel"=dword:00000001
"ConnectFunctions"="YYN"
"DriverODBCVer"="03.51"
"SQLLevel"=dword:00000001
